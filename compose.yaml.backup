name: hooman-portfolio

services:
  frontend:
    container_name: hooman-portfolio
    build:
      context: .
      dockerfile: Dockerfile
      args:
        NEXT_PUBLIC_API_URL: /api/v1
        NEXT_PUBLIC_BACKEND_ORIGIN: ""
        NEXT_PUBLIC_ASSET_ORIGIN: http://homan-baackend:4000
        BACKEND_ORIGIN: http://homan-baackend:4000
    env_file:
      - .env.production
    ports:
      - "127.0.0.1:3001:3000"
    restart: unless-stopped
    init: true
    networks:
      - backend-network

networks:
  backend-network:
    external: true
    name: cms-api_default
